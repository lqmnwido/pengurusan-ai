# Ollama URL for the backend to connect
# The path '/ollama' will be redirected to the specified backend URL
OLLAMA_BASE_URL='http://localhost:11434'
# OpenClaw uses this non-secret marker to enable discovery of local Ollama models.
OLLAMA_API_KEY='ollama-local'
# Context budget used by OpenClaw local agents. Increase only if host memory permits.
OPENCLAW_OLLAMA_NUM_CTX='16384'

OPENAI_API_BASE_URL=''
OPENAI_API_KEY=''

# Postgres database + pgvector retrieval store
# Native defaults use services on localhost. docker-compose.yaml overrides the hosts internally.
POSTGRES_DB='openwebui'
POSTGRES_USER='openwebui'
POSTGRES_PASSWORD='change-me'
DATABASE_URL='postgresql://openwebui:change-me@127.0.0.1:5432/openwebui'
VECTOR_DB='pgvector'
PGVECTOR_DB_URL='postgresql://openwebui:change-me@127.0.0.1:5432/openwebui'

# MinIO S3-compatible object storage
MINIO_ROOT_USER='openwebui'
MINIO_ROOT_PASSWORD='change-me-minio-secret'
MINIO_API_PORT='9000'
MINIO_CONSOLE_PORT='9001'
STORAGE_PROVIDER='s3'
STORAGE_LOCAL_CACHE='true'
S3_ENDPOINT_URL='http://127.0.0.1:9000'
S3_ACCESS_KEY_ID='openwebui'
S3_SECRET_ACCESS_KEY='change-me-minio-secret'
S3_BUCKET_NAME='open-webui'
S3_REGION_NAME='us-east-1'
S3_ADDRESSING_STYLE='path'

# Durable AI agent orchestration (Temporal)
# Start Temporal separately, then set TEMPORAL_ENABLED=true.
TEMPORAL_ENABLED='false'
TEMPORAL_ADDRESS='127.0.0.1:7233'
TEMPORAL_NAMESPACE='default'
# Native Pengurusan AI Python worker queue (`make agent-worker`).
TEMPORAL_TASK_QUEUE='pengurusan-ai-agents'
# Every OpenClaw chat/API invocation is dispatched to this worker as the
# `pengurusan_ai.openclaw.chat` workflow. Keep the API and worker values equal.
# Configurable V2T flows use `pengurusan_ai.voice.v2t` on the same queue.
# Existing temporal-worker ASR + diarization + summary + thematic pipeline.
TEMPORAL_ASR_WORKFLOW='AsrWorkflow::start'
TEMPORAL_ASR_WORKFLOW_TASK_QUEUE='ASR_WORKFLOW_QUEUE'
TEMPORAL_MEDIA_TASK_QUEUE='MEDIA_TASK_QUEUE'
TEMPORAL_ASR_TASK_QUEUE='ASR_TASK_QUEUE'
TEMPORAL_TLS='false'
# For Temporal Cloud, set TEMPORAL_TLS=true and provide the API key.
TEMPORAL_API_KEY=''
# Required only when the Pyannote diarization stage is enabled. Accept the
# selected model terms on Hugging Face before setting this token.
HF_TOKEN=''
# OpenClaw owns conversational agent workspaces and runtime.
# Run `make openclaw-setup`, finish onboarding, then enable it.
OPENCLAW_ENABLED='false'
OPENCLAW_COMMAND='openclaw'
OPENCLAW_HOME='./backend/data/openclaw'
OPENCLAW_STATE_DIR='./backend/data/openclaw'
OPENCLAW_WORKSPACE_ROOT='./backend/data/openclaw/workspaces'
# Per-agent bearer API exposed by Pengurusan AI. Keys are generated in
# Konfigurasi Agent and stored only as SHA-256 hashes.
AGENT_EXTERNAL_API_ENABLED='true'
# Shared only between the OpenClaw MCP bridge and this backend. Generate a long
# random value; do not reuse an OpenClaw Gateway or user API token.
AGENTIC_MCP_TOKEN='replace-with-a-long-random-agentic-mcp-token'
PENGURUSAN_AI_API_BASE='http://127.0.0.1:8080/api/v1/agentic-workflows'
# Run uploaded Python only inside an isolated Temporal worker container.
AGENT_PYTHON_EXECUTION_ENABLED='false'
AGENT_WORKER_NETWORK_ENABLED='false'

# Stable Diffusion / AUTOMATIC1111 local gateway.
ENABLE_IMAGE_GENERATION='true'
IMAGE_GENERATION_ENGINE='automatic1111'
AUTOMATIC1111_BASE_URL='http://127.0.0.1:7860'
IMAGE_SIZE='512x512'
IMAGE_STEPS='20'

# For production, you should only need one host as
# fastapi serves the svelte-kit built frontend and backend from the same host and port.
# To test with CORS locally, you can set something like
# CORS_ALLOW_ORIGIN='http://localhost:5173;http://localhost:8080'
CORS_ALLOW_ORIGIN='*'
WEBUI_SECRET_KEY='put-a-long-random-secret-here'

# For production you should set this to match the proxy configuration (127.0.0.1)
FORWARDED_ALLOW_IPS='*'

# DO NOT TRACK
SCARF_NO_ANALYTICS=true
DO_NOT_TRACK=true
ANONYMIZED_TELEMETRY=false

# Valkey Vector Store (requires VECTOR_DB=valkey)
# VALKEY_URL='valkey://localhost:6379'
# VALKEY_COLLECTION_PREFIX='open_webui'
# VALKEY_INDEX_TYPE='HNSW'
# VALKEY_DISTANCE_METRIC='COSINE'
# VALKEY_HNSW_M='16'
# VALKEY_HNSW_EF_CONSTRUCTION='200'
# VALKEY_HNSW_EF_RUNTIME='10'
